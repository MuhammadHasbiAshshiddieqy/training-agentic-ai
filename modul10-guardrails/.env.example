# Salin file ini menjadi ".env" lalu isi API key Anda sendiri.
# JANGAN commit file ".env" (berisi rahasia) ke Git - cukup ".env.example" ini.

GEMINI_API_KEY=isi_dengan_api_key_gemini_anda

# --- Opsional: tuning cache (Modul 9). Defaultnya sudah masuk akal untuk
# latihan - hapus tanda pagar & ubah nilainya kalau ingin bereksperimen. ---
# SEMANTIC_CACHE_THRESHOLD=0.95      # 0-1, makin tinggi makin ketat kecocokan
# SEMANTIC_CACHE_TTL_SECONDS=3600    # 1 jam
# EMBED_CACHE_TTL_SECONDS=86400      # 24 jam
